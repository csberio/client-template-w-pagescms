---
import { content } from '../lib/content.mjs';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '../styles/global.css';
const { title, description, active } = Astro.props;
const { site } = content;
const nav = [{href:'/',label:site.homeLabel,key:'home'},{href:'/historia/',label:site.historyLabel,key:'history'},{href:'/proyectos/',label:site.catalogLabel,key:'catalog'}];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.background} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body style={`--accent:${site.accent};--paper:${site.background};--ink:${site.ink}`}>
    <a class="skip" href="#contenido">{site.skipLabel}</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label={site.name}><span>{site.name}<small>{site.tagline}</small></span></a>
      <nav aria-label="Principal">{nav.map((item,i)=><a href={item.href} aria-current={active===item.key?'page':undefined}><span class="nav-number">0{i+1}</span>{item.label}</a>)}</nav>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap"><span>{site.footer}</span><span class="footer-note"><span class="dot" aria-hidden="true"></span>{site.tagline}</span></footer>
  </body>
</html>
